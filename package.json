{
    "name": "@jterrazz/telemetry",
    "version": "1.1.4",
    "description": "Unified observability for Node.js: logs, traces and metrics over OpenTelemetry, with ports & adapters.",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/package-telemetry"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": {
            "require": "./dist/index.cjs",
            "import": "./dist/index.js"
        },
        "./register": {
            "import": "./dist/register.js"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "typescript build",
        "lint": "typescript check",
        "lint:fix": "typescript fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/api-logs": "^0.223.0",
        "@opentelemetry/auto-instrumentations-node": "^0.82.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
        "@opentelemetry/resources": "^3.0.0",
        "@opentelemetry/sdk-logs": "^3.0.0",
        "@opentelemetry/sdk-metrics": "^3.0.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@jterrazz/test": "^18.0.4",
        "@jterrazz/typescript": "^11.1.2",
        "@types/node": "^25.9.9",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24"
    }
}
